# Токен вашого головного Telegram бота (отримати у @BotFather)
BOT_TOKEN=your_main_telegram_bot_token_here

# Токен другого окремого бота тільки для тривог (необов'язково)
ALERTS_BOT_TOKEN=your_alerts_only_bot_token_here

# Telegram User ID адміністратора бота (отримати через команду /myid в боті)
ADMIN_ID=123456789

# Порт для внутрішнього HTTP-сервера (опціонально для хостингів типу Render/Koyeb)
PORT=8080
