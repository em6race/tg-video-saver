# Токен вашого Telegram бота (отримати у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID адміністратора бота (отримати через команду /myid в боті)
ADMIN_ID=123456789

# Модульний плагін завантаження медіа з TikTok, YouTube, Instagram, Spotify (true / false)
# За замовчуванням true (якщо потрібно вимкнути для економії ресурсів — встановіть false)
ENABLE_MEDIA_PLUGIN=true

